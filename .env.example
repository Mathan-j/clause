# The compose container publishes on 5434, not the Postgres default 5432, to avoid
# colliding with a locally installed Postgres server on this machine.
CLAUSE_DATABASE_URL=postgresql+psycopg://clause:clause@localhost:5434/clause
CLAUSE_USER_AGENT=clause-research/0.1 (+mailto:you@example.com)

# Must name a DIFFERENT database than CLAUSE_DATABASE_URL above. The test suite
# builds its schema with `alembic upgrade head` and tears it down with `downgrade
# base` on every run (tests/conftest.py); pointing it at the same database as the
# app would destroy the ingested corpus every time `pytest` runs. tests/conftest.py
# refuses to start if the two resolve to the same URL.
CLAUSE_TEST_DATABASE_URL=postgresql+psycopg://clause:clause@localhost:5434/clause_test
