* text=auto

# Shell scripts must keep LF. A CRLF checkout makes bash fail with
# "$'\r': command not found", which would break the Stop hook on Windows.
*.sh text eol=lf

# uv reads this file literally; a trailing CR would corrupt the version string.
.python-version text eol=lf

# The market dataset is evidence, and plans/market_table.py pins its sha256.
# Any line-ending conversion changes that hash, so these files are stored
# byte-for-byte and never normalised. Without this the hash check passes on
# Windows and fails on Linux CI.
plans/data/** -text

# The corpus manifest and golden set are hashed on every `make eval`/`make
# gate` run (clause.cli._sha256_file) into manifest_sha256/golden_sha256,
# which the gate compares byte-for-byte against the committed report. This
# is the exact same lesson as plans/data/** above, generalised late: without
# it, `* text=auto` normalises these files' line endings on checkout, so the
# hash computed on a CRLF (Windows) checkout differs from the hash computed
# on an LF (Linux CI, and the blob itself) checkout of the identical commit
# -- meaning the gate could fail on its very first CI run over nothing but a
# platform difference, never a real regression.
data/** -text
